# ============================================================
# ContractLens 环境变量模板
# 使用：copy .env.example .env  然后填入真实值
# 注意：.env 已在 .gitignore 中，绝不要提交
# ============================================================

# ---------- App ----------
APP_NAME=ContractLens
DEBUG=true
LOG_LEVEL=INFO

# ---------- LLM ----------
LLM_API_KEY=
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct

# ---------- 模型 Provider 总开关 ----------
# local = 本地 CPU 推理（默认，离线、免费）
# api   = 调用远程 API（本地小模型效果不达预期时的退路）
EMBEDDING_PROVIDER=local
RERANK_PROVIDER=local

# ---------- 本地模型（PROVIDER=local 时生效）----------
MODELS_DIR=./models
EMBEDDING_MODEL_NAME=bge-base-zh-v1.5
RERANK_MODEL_NAME=bge-reranker-base
EMBEDDING_DIM=768

# CPU 推理线程数。torch 默认吃满所有核心，并发时会互相抢占，
# 留出余量给 FastAPI 事件循环和系统进程。
TORCH_NUM_THREADS=4

# ---------- 模型 API 备用（PROVIDER=api 时生效）----------
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_API_MODEL=
RERANK_API_BASE=
RERANK_API_KEY=
RERANK_API_MODEL=

# ---------- Milvus ----------
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_PREFIX=contract_lens

# ---------- Redis（幂等/缓存）----------
REDIS_URL=redis://localhost:6379/0

# ---------- HuggingFace 镜像（国内下模型必需）----------
HF_ENDPOINT=https://hf-mirror.com