# ============================================================
# ContractLens 环境变量模板
# 使用：copy .env.example .env  然后填入真实值
# 注意：.env 已在 .gitignore 中，绝不要提交
# ============================================================

# ---------- App ----------
APP_NAME=ContractLens
DEBUG=true
LOG_LEVEL=INFO

# ---------- LLM ----------
LLM_API_KEY=
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct

# ---------- 模型 Provider 总开关 ----------
# local = 本地 CPU 推理（默认，离线、免费）
# api   = 调用远程 API（本地小模型效果不达预期时的退路）
EMBEDDING_PROVIDER=local
RERANK_PROVIDER=local

# ---------- 本地模型（PROVIDER=local 时生效）----------
MODELS_DIR=./models
EMBEDDING_MODEL_NAME=bge-base-zh-v1.5
RERANK_MODEL_NAME=bge-reranker-base
EMBEDDING_DIM=768

# ---------- 切分参数 ----------
CHUNK_MAX_CHARS=400
CHUNK_OVERLAP=50

# ---------- 推理调度 ----------
# torch 内部线程数 × 并发上限 建议 ≈ CPU 物理核数，否则会互相抢占
TORCH_NUM_THREADS=4
MAX_CONCURRENT_INFERENCE=2
EMBEDDING_BATCH_SIZE=32
RERANK_BATCH_SIZE=16

# query 侧的指令前缀（BGE 训练时使用）。留空则不加。
# ⚠️ 本文件必须存为 UTF-8，存成 GBK 会读成乱码且不报错
EMBEDDING_QUERY_INSTRUCTION=为这个句子生成表示以用于检索相关文章：

# Cross-Encoder 的截断长度。W2 优化时可从 512 降到 256
RERANK_MAX_LENGTH=512

# provider=api 时的 HTTP 超时（秒）
MODEL_API_TIMEOUT=30

# ---------- 模型 API 备用（PROVIDER=api 时生效）----------
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_API_MODEL=
RERANK_API_BASE=
RERANK_API_KEY=
RERANK_API_MODEL=

# ---------- Milvus ----------
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_PREFIX=contract_lens

# ---------- Milvus 索引与写入 ----------
MILVUS_INSERT_BATCH_SIZE=256
# HNSW=近似检索（快、占内存）；FLAT=精确检索（小数据量下可当无误差基线）
MILVUS_DENSE_INDEX=HNSW
MILVUS_HNSW_M=16
MILVUS_HNSW_EF_CONSTRUCTION=200
MILVUS_SEARCH_EF=64
# chinese=jieba 分词；standard=按字切（对「第十二条」这类编号精确匹配可能更稳）
MILVUS_TEXT_ANALYZER=chinese
MILVUS_RRF_K=60
MILVUS_TIMEOUT=10

# ---------- Redis（幂等/缓存）----------
REDIS_URL=redis://localhost:6379/0

# ---------- HuggingFace 镜像（国内下模型必需）----------
HF_ENDPOINT=https://hf-mirror.com